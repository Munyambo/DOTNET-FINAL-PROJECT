@page
@model Restaurant_Management_System.Pages.StaffPages.IndexModel

@{
    ViewData["Title"] = "Staff";
}

<h1>Staff</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">New Staff</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Phone</th>
            <th>Position</th>
            <th>Manager</th>
            <th>Branch</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Staff) {
        <tr>
            <td>@item.FullName</td>
            <td>@item.Phone</td>
            <td>@item.Position</td>
            <td>@(item.IsManager ? "Yes" : "No")</td>
            <td>@item.Branch?.Name</td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-success btn-sm">Edit</a>
                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Details</a>
                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>