@page
@model Restaurant_Management_System.Pages.StaffPages.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Staff Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Full Name</dt>
        <dd class="col-sm-10">@Model.Staff.FullName</dd>
        <dt class="col-sm-2">Phone</dt>
        <dd class="col-sm-10">@Model.Staff.Phone</dd>
        <dt class="col-sm-2">Position</dt>
        <dd class="col-sm-10">@Model.Staff.Position</dd>
        <dt class="col-sm-2">Manager</dt>
        <dd class="col-sm-10">@(Model.Staff.IsManager ? "Yes" : "No")</dd>
        <dt class="col-sm-2">Branch</dt>
        <dd class="col-sm-10">@Model.Staff.Branch?.Name</dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Staff.Id" class="btn btn-success">Edit</a>
    <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
</div>