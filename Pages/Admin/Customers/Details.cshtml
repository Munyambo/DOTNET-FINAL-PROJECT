@page
@model Restaurant_Management_System.Pages.CustomerPages.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Customer Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Full Name</dt>
        <dd class="col-sm-10">@Model.Customer.FullName</dd>
        <dt class="col-sm-2">Phone</dt>
        <dd class="col-sm-10">@Model.Customer.Phone</dd>
        <dt class="col-sm-2">Address</dt>
        <dd class="col-sm-10">@Model.Customer.Address</dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Customer.Id" class="btn btn-success">Edit</a>
    <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
</div>