@page
@model Restaurant_Management_System.Pages.CustomerPages.IndexModel

@{
    ViewData["Title"] = "Customers";
}

<h1>Customers</h1>

<form method="get" class="mb-3">
    <input type="text" name="SearchName" value="@Model.SearchName" class="form-control d-inline w-auto" placeholder="Search by name" />
    <button type="submit" class="btn btn-primary">Search</button>
    <a asp-page="./Index" class="btn btn-secondary">Clear</a>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Phone</th>
            <th>Address</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Customer)
        {
            <tr>
                <td>@item.FullName</td>
                <td>@item.Phone</td>
                <td>@item.Address</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-success btn-sm">Edit</a>
                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>