@page
@model Restaurant_Management_System.Pages.BranchPages.IndexModel

@{
    ViewData["Title"] = "Branches";
}

<h1>Branches</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">New Branch</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Branch[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Branch[0].Address)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Branch[0].Phone)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Branch) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.Address)
            </td>
            <td>
                @Html.DisplayFor(model => item.Phone)
            </td>
            <td>
                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-success btn-sm">Edit</a>
                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Details</a>
                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
