@page
@model Restaurant_Management_System.Pages.MenuItemPages.CreateModel

@{
    ViewData["Title"] = "New Menu Item";
}

<h1>New Menu Item</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="MenuItem.Name" class="control-label"></label>
                <input asp-for="MenuItem.Name" class="form-control" aria-required="true" />
                <span asp-validation-for="MenuItem.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="MenuItem.Price" class="control-label"></label>
                <input asp-for="MenuItem.Price" class="form-control" aria-required="true" />
                <span asp-validation-for="MenuItem.Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MenuItem.Description" class="control-label"></label>
                <textarea asp-for="MenuItem.Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="MenuItem.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="MenuItem.CategoryId" class="control-label"></label>
                <select asp-for="MenuItem.CategoryId" asp-items="Model.Categories" class="form-control">
                    <option value="">-- Select category --</option>
                </select>
                <span asp-validation-for="MenuItem.CategoryId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MenuItem.IsAvailable" class="control-label"></label>
                <input asp-for="MenuItem.IsAvailable" class="form-check-input" />
                <span asp-validation-for="MenuItem.IsAvailable" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<br />
<div>
    <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
