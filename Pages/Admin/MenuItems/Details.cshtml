@page
@model Restaurant_Management_System.Pages.MenuItemPages.DetailsModel

@{
    ViewData["Title"] = "Menu Item Details";
}
<h1>Menu Item Details</h1>

<div>

    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.MenuItem.Name</dd>
        <dt class="col-sm-2">Category</dt>
        <dd class="col-sm-10">@Model.MenuItem.Category?.Name</dd>
        <dt class="col-sm-2">Price</dt>
        <dd class="col-sm-10">@Model.MenuItem.Price.ToString("N2")</dd>
        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.MenuItem.Description</dd>
        <dt class="col-sm-2">Available</dt>
        <dd class="col-sm-10">@(Model.MenuItem.IsAvailable ? "Yes" : "No")</dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.MenuItem.Id" class="btn btn-success">Edit</a>
    <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
</div>
