@page
@model Restaurant_Management_System.Pages.CustomerArea.CartModel

@{
    ViewData["Title"] = "My Cart";
}

<h1>My Cart</h1>

@if (Model.Message != null)
{
    <div class="alert alert-info">@Model.Message</div>
}

@if (!Model.Lines.Any())
{
    <p>Your cart is empty.</p>
    <a asp-page="./Menu" class="btn btn-primary">Go to Menu</a>
}
else
{
    <form method="post" asp-page-handler="Update">
        <table class="table">
            <thead>
                <tr>
                    <th>Item</th>
                    <th>Price</th>
                    <th style="width: 120px;">Quantity</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td>@line.MenuItem.Name</td>
                        <td>@line.MenuItem.Price.ToString("N2")</td>
                        <td>
                            <input type="hidden" name="menuItemIds" value="@line.MenuItem.Id" />
                            <input type="number" name="quantities" value="@line.Quantity" min="0" max="50" class="form-control" />
                        </td>
                        <td>@line.LineTotal.ToString("N2")</td>
                        <td>
                            <button type="submit" formaction="?handler=Remove&menuItemId=@line.MenuItem.Id" class="btn btn-danger btn-sm">Remove</button>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Total</th>
                    <th>@Model.Total.ToString("N2")</th>
                    <th></th>
                </tr>
            </tfoot>
        </table>

        <div class="mt-4">
            <button type="submit" class="btn btn-success">Update Cart</button>
            <a asp-page="./Checkout" class="btn btn-primary">Checkout</a>
            <a asp-page="./Menu" class="btn btn-secondary">Continue Shopping</a>
        </div>
    </form>
}
