@page
@model Restaurant_Management_System.Pages.CustomerArea.MenuModel

@{
    ViewData["Title"] = "Menu";
}

<h1>Menu</h1>

<p>Items in your cart: <strong>@Model.CartCount</strong></p>

@if (Model.Message != null)
{
    <div class="alert alert-success">@Model.Message</div>
}

@if (!Model.Groups.Any())
{
    <p>There is no food available right now. Please come back later.</p>
}
else
{
    @foreach (var group in Model.Groups)
    {
        <h3 class="mt-4">@group.Key</h3>
        <hr />
        <div class="row">
            @foreach (var item in group)
            {
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">@item.Name</h5>
                            <p class="card-text">@item.Description</p>
                            <p class="card-text"><strong>@item.Price.ToString("N2")</strong></p>
                            <form method="post" asp-page-handler="Add" class="d-flex gap-2">
                                <input type="hidden" name="menuItemId" value="@item.Id" />
                                <input type="number" name="quantity" value="1" min="1" max="50" class="form-control" style="width: 80px;" />
                                <button type="submit" class="btn btn-primary">Add to Cart</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
