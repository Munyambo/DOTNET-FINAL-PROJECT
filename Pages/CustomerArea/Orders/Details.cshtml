@page
@model Restaurant_Management_System.Pages.CustomerArea.Orders.DetailsModel

@{
    ViewData["Title"] = "Order Details";
}

<h1>Order #@Model.Order.Id</h1>
<hr />

<dl class="row">
    <dt class="col-sm-2">Date</dt>
    <dd class="col-sm-10">@Model.Order.OrderDate.ToString("dd MMM yyyy HH:mm")</dd>

    <dt class="col-sm-2">Branch</dt>
    <dd class="col-sm-10">@Model.Order.Branch?.Name</dd>

    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">@Model.Order.Status</dd>
</dl>

<h4>Order Progress</h4>
@if (Model.IsCancelled)
{
    <div class="alert alert-danger">This order was cancelled.</div>
}
else
{
    <div class="progress mb-2" style="height: 24px;">
        <div class="progress-bar @(Model.Order.Status == "Completed" ? "bg-success" : "")"
             role="progressbar" style="width: @Model.Percent%">
            @Model.Percent%
        </div>
    </div>
    <div class="d-flex justify-content-between mb-4">
        @for (int i = 0; i < DetailsModel.Steps.Length; i++)
        {
            <span class="@(i <= Model.CurrentStep ? "fw-bold" : "text-muted")">@DetailsModel.Steps[i]</span>
        }
    </div>
}

<h4>Items</h4>
<table class="table">
    <thead>
        <tr>
            <th>Item</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Line Total</th>
            <th>Special Instructions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Order.Items)
        {
            <tr>
                <td>@item.MenuItem?.Name</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("N0")</td>
                <td>@((item.Quantity * item.UnitPrice).ToString("N0"))</td>
                <td>@item.SpecialInstructions</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3" class="text-end">Total</th>
            <th colspan="2">@Model.Order.TotalAmount.ToString("N0")</th>
        </tr>
    </tfoot>
</table>
<br />
<div>
    <a asp-page="./Index" class="btn btn-secondary">Back to My Orders</a>
</div>