@page
@model Restaurant_Management_System.Pages.CustomerArea.Orders.IndexModel

@{
    ViewData["Title"] = "My Orders";
}

<h1>My Orders</h1>

@if (!Model.Orders.Any())
{
    <p>You have not placed any orders yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Order #</th>
                <th>Date</th>
                <th>Branch</th>
                <th>Total</th>
                <th>Status</th>
				<th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Orders)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.OrderDate.ToString("dd MMM yyyy HH:mm")</td>
                    <td>@item.Branch?.Name</td>
                    <td>@item.TotalAmount.ToString("N0")</td>
                    <td>
                        <span class="badge @Model.GetBadgeClass(item.Status)">@item.Status</span>
                    </td>
					<td>
						<a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Details</a>
                </tr>
            }
        </tbody>
    </table>
}