@page
@model Restaurant_Management_System.Pages.CustomerArea.CheckoutModel

@{
    ViewData["Title"] = "Checkout";
}

<h1>Checkout</h1>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <table class="table">
        <thead>
            <tr>
                <th>Item</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Total</th>
                <th>Special instructions</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Lines.Count; i++)
            {
                var line = Model.Lines[i];
                <tr>
                    <td>@line.MenuItem.Name</td>
                    <td>@line.MenuItem.Price.ToString("N2")</td>
                    <td>@line.Quantity</td>
                    <td>@line.LineTotal.ToString("N2")</td>
                    <td>
                        <input name="Instructions" maxlength="300" class="form-control" placeholder="Optional (e.g. no onions)" />
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Total</th>
                <th colspan="2">@Model.Total.ToString("N2")</th>
            </tr>
        </tfoot>
    </table>

    <div class="row">
        <div class="col-md-4">
            <div class="form-group mb-3">
                <span class="text-danger">*</span>
                <label asp-for="BranchId" class="control-label">Branch</label>
                <select asp-for="BranchId" asp-items="Model.Branches" class="form-control">
                    <option value="">-- Select branch --</option>
                </select>
                <span asp-validation-for="BranchId" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Place Order</button>
        <a asp-page="./Cart" class="btn btn-secondary">Back to Cart</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
