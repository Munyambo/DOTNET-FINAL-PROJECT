@page
@model IndexModel
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Home page";

    // Who is visiting? (null = not logged in)
    var role = HttpContext.Session.GetString("Role");
    var name = HttpContext.Session.GetString("Name");
}

<div class="rounded text-center text-white d-flex flex-column justify-content-center align-items-center"
     style="height: calc(100vh - 170px);
    background: linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.45)),
    url('/images/restaurant.jpg') center / cover no-repeat;">

    @if (role == null)
    {
        @* ===== VISITOR: invite them to join ===== *@
        <h1 class="fw-bold">Welcome to our Restaurant</h1>
        <p class="fs-5 mb-4">Browse our menu, order online and track your order.</p>
        <div>
            <a asp-page="/Account/Register" class="btn btn-warning btn-lg me-2">Register</a>
            <a asp-page="/Account/Login" class="btn btn-outline-light btn-lg">Login</a>
        </div>
    }
    else if (role == "Customer")
    {
        @* ===== CUSTOMER: friendly, food-focused ===== *@
        <h1 class="fw-bold">Muraho, @name! 👋</h1>
        <p class="fs-5 mb-4">Hungry? Fresh meals are waiting for you. Order in a few clicks and follow it live.</p>
        <div>
            @* Mushi: add the Menu button here when the Menu page is ready *@
            <a asp-page="/CustomerArea/Orders/Index" class="btn btn-warning btn-lg me-2">My Orders</a>
            <a asp-page="/CustomerArea/Profile" class="btn btn-outline-light btn-lg">My Profile</a>
        </div>
    }
    else if (role == "Staff")
    {
        @* ===== STAFF: straight to work ===== *@
        <h1 class="fw-bold">Good to see you, @name!</h1>
        <p class="fs-5 mb-4">New orders may be waiting for your branch. Let's keep our customers happy.</p>
        <div>
            <a asp-page="/StaffArea/Orders/Index" class="btn btn-warning btn-lg me-2">View Orders</a>
            <a asp-page="/StaffArea/Dashboard" class="btn btn-outline-light btn-lg">Dashboard</a>
        </div>
    }
    else if (role == "Admin")
    {
        @* ===== ADMIN: overview of the whole restaurant ===== *@
        <h1 class="fw-bold">Welcome back, @name</h1>
        <p class="fs-5 mb-4">Manage your branches, team and menu, and keep an eye on sales.</p>
        <div>
            <a asp-page="/StaffArea/Dashboard" class="btn btn-warning btn-lg me-2">Dashboard</a>
            <a asp-page="/Admin/Branches/Index" class="btn btn-outline-light btn-lg me-2">Branches</a>
            <a asp-page="/StaffArea/Reports" class="btn btn-outline-light btn-lg">Reports</a>
        </div>
    }
</div>