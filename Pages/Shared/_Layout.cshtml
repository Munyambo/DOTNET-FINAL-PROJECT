@using Microsoft.AspNetCore.Http

@{
    // Read the logged-in person's info from the Session ONCE (saved at Login/Register).
    // If nobody is logged in, both are null.
    var role = Context.Session.GetString("Role");   // "Admin", "Staff", "Customer" or null
    var name = Context.Session.GetString("Name");   // "Jean" or "Admin"
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    @* Makes the page fit phone screens *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    @* Browser tab text: each page sets ViewData["Title"] *@
    <title>@ViewData["Title"] - Restaurant_Management_System</title>
    <script type="importmap"></script>

    @* Styles: Bootstrap (ready-made design) + our own CSS files *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Restaurant_Management_System.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        @* The navbar at the top of EVERY page *@
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">

                @* Brand name on the far left, clicks back to the Home page *@
                <a class="navbar-brand" asp-area="" asp-page="/Index">RMS - Restaurant</a>

                @* "Hamburger" button: only appears on small screens (phones) to open the menu *@
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                @* Holds the two link lists; "justify-content-between" pushes one left and one right *@
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    @* ===== LEFT LIST: the pages ===== *@
                    @* "flex-grow-1" makes this list take the free space, pushing the right list to the edge *@
                    <ul class="navbar-nav flex-grow-1">

                        @* Everyone sees these two *@
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Index">RMS - Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Privacy">Our Privacy</a>
                        </li>

                        @* Only the ADMIN sees these (pages inside Pages/Admin) *@
                        @if (role == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/Admin/Branches/Index">Branches</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/Admin/StaffMembers/Index">Staff</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/Admin/Customers/Index">Customers</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/Admin/Categories/Index">Categories</a>
                            </li>
                        }

                        @* STAFF and ADMIN see these (pages inside Pages/StaffArea). "||" means OR *@
                        @if (role == "Staff" || role == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/StaffArea/Orders/Index">Orders</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/StaffArea/Dashboard">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/StaffArea/Reports">Reports</a>
                            </li>
                        }

                        @* Only CUSTOMERS see this (pages inside Pages/CustomerArea) *@
                        @if (role == "Customer")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/CustomerArea/Menu">Menu</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/CustomerArea/Orders/Index">My Orders</a>
                            </li>
                        }
                    </ul>

                    @* ===== RIGHT LIST: who is logged in ===== *@
                    <ul class="navbar-nav">

                        @* Only shown when someone is logged in (role is not null) *@
                        @if (role != null)
                        {
                            @* Greeting with the person's name and role, e.g. "Welcome, Jean (Staff)" *@
                            <li class="nav-item">
                                <span class="nav-link text-dark">Welcome, @name (@role)</span>
                            </li>

                            @* Only customers have a profile to edit *@
                            @if (role == "Customer")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-page="/CustomerArea/Profile">My Profile</a>
                                </li>
                            }

                            @* Logout is a POST form (not a link) so it can't be triggered by accident *@
                            <li class="nav-item">
                                <form method="post" asp-page="/Account/Logout">
                                    <button type="submit" class="btn btn-link nav-link text-dark">Logout</button>
                                </form>
                            </li>
                        }
                        @* No "else": visitors see nothing here. Login/Register are on the Home page *@
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @* ===== THE PAGE CONTENT ===== *@
    <div class="container">
        <main role="main" class="pb-3">
            @* Each page's own content (Branches list, Login form...) is inserted HERE *@
            @RenderBody()
        </main>
    </div>

    @* Footer at the bottom of every page *@
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Restaurant_Management_System - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    @* JavaScript: jQuery (needed by validation), Bootstrap (navbar on phones), our own site.js *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* Extra scripts a page can add (e.g. the validation scripts on Register and Create forms) *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>