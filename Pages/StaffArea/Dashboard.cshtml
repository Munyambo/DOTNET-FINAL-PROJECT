@page
@model Restaurant_Management_System.Pages.StaffArea.DashboardModel

@{
    ViewData["Title"] = "Dashboard";
}

<h1>Dashboard</h1>
<p class="text-muted">@Model.Scope</p>


<div class="row row-cols-1 row-cols-sm-3 g-3 mb-4">

    <div class="col">
        <div class="card h-100 text-center border-primary border-3 border-top border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted">Total Orders</div>
                <div class="display-6 fw-bold">@Model.TotalOrders</div>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card h-100 text-center border-warning border-3 border-top border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted">Pending Orders</div>
                <div class="display-6 fw-bold">@Model.PendingOrders</div>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card h-100 text-center border-success border-3 border-top border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted">Total Sales <small>(completed, RWF)</small></div>
                <div class="display-6 fw-bold">@Model.TotalSales.ToString("N0")</div>
            </div>
        </div>
    </div>
</div>

<a asp-page="./Orders/Index" class="btn btn-primary">View Orders</a>
<a asp-page="./Reports" class="btn btn-secondary">View Reports</a>