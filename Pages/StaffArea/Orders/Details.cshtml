@page
@model Restaurant_Management_System.Pages.StaffArea.Orders.DetailsModel

@{
    ViewData["Title"] = "Order Details";
}

<h1>Order #@Model.Order.Id</h1>
<hr />

@if (Model.Message != null)
{
    <div class="alert alert-success">@Model.Message</div>
}

<dl class="row">
    <dt class="col-sm-2">Date</dt>
    <dd class="col-sm-10">@Model.Order.OrderDate.ToString("dd MMM yyyy HH:mm")</dd>

    <dt class="col-sm-2">Customer</dt>
    <dd class="col-sm-10">@Model.Order.Customer?.FullName</dd>

    <dt class="col-sm-2">Phone</dt>
    <dd class="col-sm-10">@Model.Order.Customer?.Phone</dd>

    <dt class="col-sm-2">Branch</dt>
    <dd class="col-sm-10">@Model.Order.Branch?.Name</dd>

    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">
        <span class="badge @Model.GetBadgeClass(Model.Order.Status)">@Model.Order.Status</span>
    </dd>
</dl>

<h4>Update Status</h4>
<form method="post" asp-route-id="@Model.Order.Id" class="mb-4">
    <select name="newStatus" class="form-select w-auto d-inline-block">
        @foreach (var s in DetailsModel.AllStatuses)
        {
            <option value="@s" selected="@(s == Model.Order.Status)">@s</option>
        }
    </select>
    <button type="submit" class="btn btn-success">Update</button>
</form>

<h4>Items</h4>
<table class="table">
    <thead>
        <tr>
            <th>Item</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Line Total</th>
            <th>Special Instructions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Order.Items)
        {
            <tr>
                <td>@item.MenuItem?.Name</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("N0")</td>
                <td>@((item.Quantity * item.UnitPrice).ToString("N0"))</td>
                <td>@item.SpecialInstructions</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3" class="text-end">Total</th>
            <th colspan="2">@Model.Order.TotalAmount.ToString("N0")</th>
        </tr>
    </tfoot>
</table>
<br />
<div>
    <a asp-page="./Index" class="btn btn-secondary">Back to Orders</a>
</div>