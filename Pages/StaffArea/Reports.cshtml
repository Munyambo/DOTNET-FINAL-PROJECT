@page
@model Restaurant_Management_System.Pages.StaffArea.ReportsModel

@{
    ViewData["Title"] = "Reports";
}

<h1>Reports</h1>
<p class="text-muted">@Model.Scope</p>

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-auto">
        <label asp-for="From" class="form-label">From</label>
        <input asp-for="From" type="date" class="form-control" />
    </div>
    <div class="col-auto">
        <label asp-for="To" class="form-label">To</label>
        <input asp-for="To" type="date" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a asp-page="./Reports" class="btn btn-secondary">Clear</a>
    </div>
</form>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
else
{
    <h4>Sales per Branch <small class="text-muted fs-6">(Completed orders)</small></h4>
    @if (!Model.SalesPerBranch.Any())
    {
        <p>No completed orders for this period.</p>
    }
    else
    {
        <table class="table mb-4">
            <thead>
                <tr>
                    <th>Branch</th>
                    <th>Completed Orders</th>
                    <th>Total Sales</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.SalesPerBranch)
                {
                    <tr>
                        <td>@row.BranchName</td>
                        <td>@row.Orders</td>
                        <td>@row.Sales.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h4>Top 5 Ordered Items <small class="text-muted fs-6">(excluding cancelled orders)</small></h4>
    @if (!Model.TopItems.Any())
    {
        <p>No items ordered for this period.</p>
    }
    else
    {
        <table class="table mb-4">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Item</th>
                    <th>Quantity Ordered</th>
                    <th>Revenue</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var rank = 1;
                }
                @foreach (var row in Model.TopItems)
                {
                    <tr>
                        <td>@(rank++)</td>
                        <td>@row.Name</td>
                        <td>@row.Quantity</td>
                        <td>@row.Revenue.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h4>Orders by Status</h4>
    <table class="table mb-4">
        <thead>
            <tr>
                <th>Status</th>
                <th>Orders</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var status in ReportsModel.AllStatuses)
            {
                <tr>
                    <td><span class="badge @Model.GetBadgeClass(status)">@status</span></td>
                    <td>@(Model.StatusCounts.TryGetValue(status, out var count) ? count : 0)</td>
                </tr>
            }
        </tbody>
    </table>
}