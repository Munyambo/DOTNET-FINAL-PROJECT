@page
@model Restaurant_Management_System.Pages.StaffArea.ReportsModel

@{
    ViewData["Title"] = "Reports";
}

<h1>Reports</h1>
<p class="text-muted">@Model.Scope</p>


<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-auto">
        <label asp-for="From" class="form-label">From</label>
        <input asp-for="From" type="date" class="form-control" />
    </div>
    <div class="col-auto">
        <label asp-for="To" class="form-label">To</label>
        <input asp-for="To" type="date" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a asp-page="./Reports" class="btn btn-secondary">Clear</a>
    </div>
</form>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
else
{

    <h5 class="mb-2">Orders by Status</h5>
    <div class="row row-cols-3 row-cols-md-6 g-2 mb-4">
        @foreach (var status in ReportsModel.AllStatuses)
        {
            <div class="col">
                <div class="card text-center h-100">
                    <div class="card-body py-2">
                        <span class="badge @Model.GetBadgeClass(status)">@status</span>
                        <div class="fs-4 fw-bold mt-1">@(Model.StatusCounts.TryGetValue(status, out var count) ? count : 0)</div>
                    </div>
                </div>
            </div>
        }
    </div>

 
    <div class="row g-4">

        
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header fw-bold">
                    Sales per Branch <small class="text-muted fw-normal">(completed orders)</small>
                </div>
                <div class="card-body">
                    @if (!Model.SalesPerBranch.Any())
                    {
                        <p class="text-muted mb-0">No completed orders for this period.</p>
                    }
                    else
                    {
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Branch</th>
                                    <th class="text-end">Orders</th>
                                    <th class="text-end">Total Sales (RWF)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.SalesPerBranch)
                                {
                                    <tr>
                                        <td>@row.BranchName</td>
                                        <td class="text-end">@row.Orders</td>
                                        <td class="text-end">@row.Sales.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>

       
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header fw-bold">
                    Top 5 Ordered Items <small class="text-muted fw-normal">(excluding cancelled)</small>
                </div>
                <div class="card-body">
                    @if (!Model.TopItems.Any())
                    {
                        <p class="text-muted mb-0">No items ordered for this period.</p>
                    }
                    else
                    {
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Item</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-end">Revenue (RWF)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var rank = 1;
                                }
                                @foreach (var row in Model.TopItems)
                                {
                                    <tr>
                                        <td>@(rank++)</td>
                                        <td>@row.Name</td>
                                        <td class="text-end">@row.Quantity</td>
                                        <td class="text-end">@row.Revenue.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
}